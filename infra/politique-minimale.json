{
  "Version": "2012-10-17",
  "Id": "radar-entreprises-herault-droits-minimaux",
  "Statement": [
    {
      "Sid": "ListerLeCompartimentSurLeSeulPrefixeDuProjet",
      "Effect": "Allow",
      "Action": ["s3:ListBucket", "s3:GetBucketLocation"],
      "Resource": "arn:aws:s3:::amzn-s3-seau",
      "Condition": {
        "StringLike": {
          "s3:prefix": ["radar", "radar/*"]
        }
      }
    },
    {
      "Sid": "LireEtEcrireLesObjetsDuProjet",
      "Effect": "Allow",
      "Action": [
        "s3:GetObject",
        "s3:PutObject",
        "s3:AbortMultipartUpload",
        "s3:ListMultipartUploadParts"
      ],
      "Resource": "arn:aws:s3:::amzn-s3-seau/radar/*"
    },
    {
      "Sid": "RefuserToutCeQuiSortDuPrefixeDuProjet",
      "Effect": "Deny",
      "Action": "s3:*",
      "NotResource": [
        "arn:aws:s3:::amzn-s3-seau",
        "arn:aws:s3:::amzn-s3-seau/radar/*"
      ]
    }
  ]
}
