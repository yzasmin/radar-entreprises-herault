# Copier en .env pour changer les valeurs. Le fichier .env est ignore par git.
# Sans .env, docker compose utilise les valeurs par defaut ci-dessous.

# --- Cible S3 ---------------------------------------------------------------
#
# Ce fichier d'exemple decrit le chemin de REPLI : LocalStack, pour qui n'a pas
# de compte AWS. Il ne contient aucun secret, « test » est la paire que
# LocalStack accepte de tout le monde.
#
# Pour parler au VRAI compte, trois lignes changent et rien d'autre :
#   AWS_ENDPOINT_URL=              (VIDE : c'est cette ligne qui bascule)
#   AWS_ACCESS_KEY_ID=AKIA...      (cle creee dans la console IAM)
#   AWS_SECRET_ACCESS_KEY=...      (affichee une seule fois par AWS)
# Ne jamais recopier une vraie cle ici : ce fichier est commite, .env ne l'est pas.
AWS_ENDPOINT_URL=http://localstack:4566
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
# eu-north-1 (Stockholm) : region reelle du compartiment amzn-s3-seau.
AWS_REGION=eu-north-1
# AWS_DEFAULT_REGION est le nom que connait l'outil aws ; les deux sont lus.
AWS_DEFAULT_REGION=eu-north-1

# --- Radar ------------------------------------------------------------------
# S3_BUCKET est accepte comme equivalent de RADAR_BUCKET.
RADAR_BUCKET=amzn-s3-seau
RADAR_PREFIXE=radar
RADAR_DEPARTEMENT=34
# duckdb (sans compte AWS) ou athena (avec compte AWS)
RADAR_MOTEUR=duckdb
RADAR_GLUE_DB=radar_entreprises
RADAR_ATHENA_WORKGROUP=radar
# Enrichissement SIRENE via l'API Recherche d'entreprises (sans cle, 7 req/s max)
RADAR_ENRICHISSEMENT=1
RADAR_MAX_SIRENS=800
# Fils paralleles de l'enrichissement (la cadence globale reste RADAR_RPS)
RADAR_FILS=5
RADAR_RPS=5

# --- Airflow ----------------------------------------------------------------
POSTGRES_USER=airflow
POSTGRES_PASSWORD=change-moi
POSTGRES_DB=airflow
AIRFLOW_ADMIN_USER=admin
AIRFLOW_ADMIN_PASSWORD=change-moi
AIRFLOW_PORT=8080
LOCALSTACK_PORT=4566
