# Copier en .env pour changer les valeurs. Le fichier .env est ignore par git.
# Sans .env, docker compose utilise les valeurs par defaut ci-dessous.

# --- Cible S3 ---------------------------------------------------------------
# LocalStack tant que le compte AWS n'est pas ouvert.
# Pour basculer sur le vrai AWS : laisser AWS_ENDPOINT_URL VIDE et renseigner
# une vraie paire de cles. C'est la seule difference dans tout le projet.
AWS_ENDPOINT_URL=http://localstack:4566
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
AWS_REGION=eu-west-3

# --- Radar ------------------------------------------------------------------
RADAR_BUCKET=radar-entreprises-herault
RADAR_PREFIXE=radar
RADAR_DEPARTEMENT=34
# duckdb (sans compte AWS) ou athena (avec compte AWS)
RADAR_MOTEUR=duckdb
RADAR_GLUE_DB=radar_entreprises
RADAR_ATHENA_WORKGROUP=radar
# Enrichissement SIRENE via l'API Recherche d'entreprises (sans cle, 7 req/s max)
RADAR_ENRICHISSEMENT=1
RADAR_MAX_SIRENS=400
RADAR_RPS=5

# --- Airflow ----------------------------------------------------------------
POSTGRES_USER=airflow
POSTGRES_PASSWORD=change-moi
POSTGRES_DB=airflow
AIRFLOW_ADMIN_USER=admin
AIRFLOW_ADMIN_PASSWORD=change-moi
AIRFLOW_PORT=8080
LOCALSTACK_PORT=4566
